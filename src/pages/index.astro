---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Terminal from '../components/Terminal.astro';
import CodeBlock from '../components/CodeBlock.astro';
import StudioDemo from '../components/StudioDemo.astro';
import { readFileSync } from 'node:fs';
import tokensCss from '../styles/tokens.css?raw';
import tailwindOut from '../generated/tailwind.css?raw';
import jsonOut from '../generated/tokens.json?raw';

const designMdFull = readFileSync('design.md', 'utf8');
const designMd = designMdFull.split('\n').slice(0, 22).join('\n') + '\n…';

// Honest excerpts from the real generated files.
const cssLines = tokensCss.split('\n').filter((l) => !l.startsWith('@import'));
const cssSample = [
  ...cssLines.slice(0, 10),
  '  /* … every color step, font stack, radius & gradient token */',
  '}',
].join('\n');

const twLines = tailwindOut.split('\n');
const themeAt = twLines.findIndex((l) => l.trim() === '@theme {');
const tailwindSample = [
  twLines[0],
  twLines[1],
  '',
  ...twLines.slice(themeAt, themeAt + 8),
  '  /* … */',
  '}',
].join('\n');

const jsonLines = jsonOut.split('\n');
const jsonSample = [
  ...jsonLines.slice(0, 12),
  '    …',
  '}',
].join('\n');

const outputs = [
  {
    id: 'css',
    label: 'tokens.css',
    lang: 'tokens.css',
    note: 'Custom properties. Paste into any stylesheet and the site is themed.',
    code: cssSample,
  },
  {
    id: 'tailwind',
    label: 'app.css',
    lang: 'app.css',
    note: 'A Tailwind v4 @theme. Utilities like bg-primary-600 just work after import.',
    code: tailwindSample,
  },
  {
    id: 'json',
    label: 'tokens.json',
    lang: 'tokens.json',
    note: 'W3C DTCG format. Figma plugins and Style Dictionary read it as-is.',
    code: jsonSample,
  },
  {
    id: 'design-md',
    label: 'design.md',
    lang: 'markdown',
    note: 'A briefing for your AI agent. Every token plus usage rules, in one file.',
    code: designMd,
  },
];

const features = [
  {
    title: 'A whole look in one pick',
    body: 'Pick a style like retro or neon. Kernic fills in the rest: colors, fonts, spacing. Change anything later.',
  },
  {
    title: 'Colors that just work',
    body: 'Scales generated in OKLCH, a color space where every step stays evenly bright. No muddy colors.',
  },
  {
    title: 'Exports that pipe anywhere',
    body: 'css, tailwind, json, and design.md print to stdout or a file. One command in your build and it stays current.',
  },
  {
    title: 'Your agent stops guessing',
    body: 'Vibe-coded apps look generic because the agent makes up colors as it goes. Hand it design.md once and it uses your system.',
  },
  {
    title: '~2k Google Fonts',
    body: 'Search ~2k Google Fonts from your terminal. Pick heading, body, and mono fonts. Offline fallback included.',
  },
  {
    title: 'Gradients included',
    body: 'Gradients for backgrounds, buttons, and headlines. Shipped as tokens in CSS vars and Tailwind utilities.',
  },
];
---

<Base>
  <Header />

  <main>
    <section class="hero">
      <div class="hero-backdrop" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-inner">
          <h1>Vibe coding gets a <span class="grad-text">facelift</span>.</h1>
          <p class="hero-lede">
            Answer a few questions in your terminal. Kernic picks colors, fonts, and spacing
            that work together, then exports them as CSS or Tailwind tokens. No design
            experience needed.
          </p>
          <div class="hero-actions">
            <span class="install-pill"><span class="prompt">$</span> npm install -g kernic</span>
            <a class="btn btn-primary" href="/docs">Get started</a>
            <a class="btn btn-ghost hero-ghost" href="https://github.com/intentionaut/kernic" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
        <div class="hero-terminal">
          <Terminal />
        </div>
      </div>
    </section>

    <section class="section" id="outputs">
      <div class="container">
        <h2 class="section-title">One system. Every output.</h2>
        <p class="section-lede">
          This site is styled by its own product. One command at build time writes
          exactly what your stack needs. Each
          snippet below is cut from this site's real files.
        </p>
        <div class="tabs" role="tablist" aria-label="Export formats">
          {outputs.map((o, i) => (
            <button
              class="tab"
              role="tab"
              id={`tab-${o.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${o.id}`}
            >
              {o.label}
            </button>
          ))}
        </div>
        {outputs.map((o, i) => (
          <div
            id={`panel-${o.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${o.id}`}
            hidden={i !== 0}
          >
            <p class="output-note">{o.note}</p>
            <div class="panel-scroll">
              <CodeBlock code={o.code} lang={o.lang} />
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2 class="section-title">What's in the box</h2>
        <div class="card-grid">
          {features.map((f) => (
            <article class="card">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="vibes">
      <div class="container">
        <h2 class="section-title">Pick a vibe</h2>
        <p class="section-lede">
          Eight presets, each one real inside kernic. Click one and watch the preview change. Then push the controls. This site runs on <strong>corporate</strong>.
        </p>

        <StudioDemo />

        <div class="sp-footnote">
          <p>
            The real editor runs locally with live OKLCH ramps, hue harmonies and ~2k
            Google Fonts. Studio, the cloud tier, adds multi-brand management, sync
            across repos and version history on top.
          </p>
          <div class="sp-cta-row">
            <span class="install-pill"><span class="prompt">$</span> npx kernic studio</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="cta-panel">
          <h2>Free forever. MIT licensed.</h2>
          <p>Runs on your machine. Your design system is a plain JSON file you own.</p>
          <span class="install-pill install-pill-light"><span class="prompt">$</span> npx kernic</span>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script is:inline>
  document.addEventListener('click', (e) => {
    const tab = e.target instanceof Element && e.target.closest('[role="tab"]');
    if (!tab) return;
    const list = tab.closest('[role="tablist"]');
    for (const t of list.querySelectorAll('[role="tab"]')) {
      t.setAttribute('aria-selected', String(t === tab));
      document.getElementById(t.getAttribute('aria-controls'))?.toggleAttribute('hidden', t !== tab);
    }
  });
</script>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: var(--space-3);
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .sp-footnote {
    margin-top: var(--space-1-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .sp-footnote p {
    font-size: var(--text-sm);
    color: var(--muted-text);
    max-width: 58ch;
    line-height: 1.55;
  }
</style>
