---
---
<header class="site-header">
  <div class="container site-header-inner">
    <a href="/" class="wordmark" aria-label="kernic home">
      <svg class="wordmark-mark" width="19" height="19" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 12v40" />
        <path d="M46 16 24 32l22 16" />
      </svg>
      <span>kernic</span>
      <span style="font-size: var(--text-xs); color: var(--muted-text); font-weight: 500;">v0.1</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href="/docs">Docs</a>
      <a href="/docs/tokens">Tokens</a>
      <a href="https://github.com/intentionaut/kernic" target="_blank" rel="noopener noreferrer">GitHub</a>
      <button class="btn-ghost btn" data-theme-toggle aria-label="Toggle color theme">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .icon-moon,
  :global(html.theme-light) .icon-sun {
    display: none;
  }
  :global(html.theme-light) .icon-moon,
  .icon-sun {
    display: block;
  }
</style>
