<div class="terminal" role="img" aria-label="A kernic terminal session creating and exporting a design system">
  <div class="terminal-bar">
    <i></i><i></i><i></i>
    <span class="terminal-title">zsh: kernic</span>
  </div>
  <pre class="terminal-body"><span class="t-prompt">$</span> <span class="t-cmd">kernic</span>

  <span class="t-key">◆ name</span>      <span class="t-val">kernic-io</span>
  <span class="t-key">◆ vibe</span>      <span class="t-val">neon</span> <span class="t-dim">(Stripe-style gradient fintech)</span>
  <span class="t-key">◆ palette</span>   <span class="t-dim">OKLCH ramps · analogous harmony · tinted neutrals</span>
  <span class="t-key">◆ fonts</span>     <span class="t-val">Inter</span> / <span class="t-val">JetBrains Mono</span>
  <span class="t-key">◇ radius</span>    <span class="t-val">soft</span>   <span class="t-key">◇ scale</span>  <span class="t-val">1.25</span>
  <span class="t-dim">└── saved → ~/.config/kernic/systems/kernic-io.json</span>

<span class="t-prompt">$</span> <span class="t-cmd">kernic export kernic-io -f css</span> &gt; src/styles/tokens.css
<span class="t-prompt">$</span> <span class="t-cmd">kernic export kernic-io -f tailwind</span> &gt; src/app.css
<span class="t-prompt">$</span> <span class="t-dim">▊</span><span class="t-cursor"></span></pre>
