---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/**
 * Release notes.
 *
 * Source of truth is CHANGELOG.md in the kernic repo. That lives in a separate
 * repository, so this page cannot import it directly and the entries below are
 * kept in step by hand. If this drifts, the changelog wins.
 */

interface Release {
  version: string;
  date: string;
  headline: string;
  standfirst?: string;
  items: { title: string; body: string }[];
  beta?: string;
  latest?: boolean;
}

const releases: Release[] = [
  {
    version: '0.1.7',
    date: '30 August 2026',
    latest: true,
    headline: 'Your coding assistant can set up your design system',
    standfirst:
      'kernic could already show an AI assistant your colors and fonts. It could not put them into your project. Now it can.',
    items: [
      {
        title: 'Ask your coding assistant to style your app, and it can',
        body: 'Ask Claude Code or Cursor to apply your design system and it writes the files, then tells you the one line to add so every future session picks it up. It can also create a system from scratch if you do not have one yet, so you are never stuck at an empty list.',
      },
      {
        title: 'Your assistant can see all 33 looks, not just the 8 styles',
        body: 'A look is a finished decision: colors, fonts, corners and text sizes, all chosen to go together. Your assistant could only see the broad styles before. Now it can offer you the finished ones.',
      },
      {
        title: 'Exporting everything now includes design.md',
        body: 'This is the file that tells an AI assistant which colors and fonts to use, and to stop inventing its own. It was the one file "export everything" left out, which is exactly backwards. You can also export it on its own, or export standard W3C design tokens.',
      },
      {
        title: 'kernic apps shows your design across every project',
        body: 'One command, one list. If a project has fallen behind because you changed the system since, it says so, and prints the exact command to bring it back.',
      },
      {
        title: 'kernic will not overwrite a file it did not write',
        body: 'tokens.json is also the filename Style Dictionary, Tokens Studio and Figma Tokens use. If you had one, kernic used to replace it with no warning and no backup. It now leaves your file alone and tells you it did.',
      },
      {
        title: 'Smaller fixes',
        body: 'kernic --version reported 0.1.0 whichever version you had. The docs described the wrong first command: running kernic has opened the visual editor since 0.1.3, and the terminal walkthrough is kernic wizard.',
      },
    ],
    beta:
      'Studio is still in beta. Picking a font works properly again: you can reach every Google Font instead of an arbitrary 30, search as you type, and pick with the keyboard. It is also much faster, and no longer requests the same fonts so often that Google starts refusing them. Studio’s local server has been hardened, so it now refuses requests from other sites on your machine. If you use kernic studio, this release is worth taking.',
  },
  {
    version: '0.1.5',
    date: '27 August 2026',
    headline: 'Two bugs in how systems are saved and listed',
    items: [
      {
        title: 'One bad file no longer hides all the others',
        body: 'A single corrupted file used to take down the whole list, hiding every system you had.',
      },
      {
        title: 'Moving from an older config folder is safe',
        body: 'The migration could remove the old folder without having moved anything out of it first.',
      },
    ],
  },
  {
    version: '0.1.4',
    date: '27 August 2026',
    headline: 'A full test suite, and a check that runs on every change',
    items: [
      {
        title: 'Nothing you can see',
        body: 'But it is why the bugs above were found at all.',
      },
    ],
  },
  {
    version: '0.1.3',
    date: '27 August 2026',
    headline: 'Running kernic now opens the visual editor',
    items: [
      {
        title: 'Colors are easier to pick by eye',
        body: 'The terminal walkthrough is still there, and is now kernic wizard.',
      },
    ],
  },
  {
    version: '0.1.2',
    date: '26 August 2026',
    headline: 'You name your system at the end, not the start',
    items: [
      {
        title: 'Naming comes last',
        body: 'Naming a thing before you have seen it is harder than naming it after.',
      },
    ],
  },
  {
    version: '0.1.1',
    date: '25 August 2026',
    headline: 'The first public releases',
    items: [
      {
        title: 'Design systems from one command',
        body: 'Colors built with real color science so every shade stays even, font pairings from the full Google Fonts catalogue, text sizes, corner radii and gradients.',
      },
      {
        title: 'Eight styles and a set of finished looks',
        body: 'Somewhere to start, including a gradient style for fintech-flavoured products.',
      },
      {
        title: 'Exports and agent context',
        body: 'CSS variables, a Tailwind v4 theme, JSON, or font tags. Plus kernic context and kernic mcp, so AI coding assistants read your design system instead of inventing colors as they go.',
      },
    ],
  },
];
---

<Base
  title="Releases | kernic"
  description="What changed in each release of kernic, and what it means for you."
>
  <Header />

  <main>
    <section class="rel-head">
      <div class="container">
        <p class="rel-kicker">Releases</p>
        <h1>New changes to <span class="grad-text">Kernic</span></h1>
        <p class="rel-lede">
          Kernic is free and open source software we pride ourselves on shipping to help
          improve the vibe-coded web.
        </p>
        <p class="install-pill"><span class="prompt">$</span> npm install -g kernic@latest</p>
      </div>
    </section>

    <section class="container rel-body">
      {releases.map((r) => (
        <article class="rel">
          <div class="rel-meta">
            <h2 id={`v${r.version}`}>
              <a href={`#v${r.version}`}>{r.version}</a>
            </h2>
            <time>{r.date}</time>
            {r.latest && <span class="rel-tag">Latest</span>}
          </div>

          <div class="rel-content">
            <h3>{r.headline}</h3>
            {r.standfirst && <p class="rel-standfirst">{r.standfirst}</p>}

            <ul class="rel-list">
              {r.items.map((item) => (
                <li>
                  <strong>{item.title}.</strong> {item.body}
                </li>
              ))}
            </ul>

            {r.beta && (
              <p class="rel-beta">
                <span class="rel-beta-tag">Beta</span>
                {r.beta}
              </p>
            )}
          </div>
        </article>
      ))}
    </section>

    <section class="container rel-foot">
      <p>
        Every version is on
        <a href="https://www.npmjs.com/package/kernic" target="_blank" rel="noopener noreferrer">npm</a>,
        and the full history is in
        <a
          href="https://github.com/intentionaut/kernic/blob/main/CHANGELOG.md"
          target="_blank"
          rel="noopener noreferrer">CHANGELOG.md</a
        >. Found something broken?
        <a
          href="https://github.com/intentionaut/kernic/issues"
          target="_blank"
          rel="noopener noreferrer">Open an issue</a
        >.
      </p>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .rel-head {
    padding: 4rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .rel-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-text);
    margin: 0 0 0.75rem;
  }

  .rel-head h1 {
    font-size: var(--text-4xl);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
    text-wrap: balance;
  }

  .rel-lede {
    max-width: 58ch;
    color: var(--muted-text);
    font-size: var(--text-lg);
    margin: 0 0 1.75rem;
  }

  .rel-body {
    padding: 3rem 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .rel {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 2rem;
    align-items: start;
  }

  .rel-meta {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    align-items: flex-start;
  }

  .rel-meta h2 {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .rel-meta h2 a {
    color: inherit;
    text-decoration: none;
  }

  .rel-meta h2 a:hover {
    color: var(--color-primary-500);
  }

  .rel-meta time {
    font-size: var(--text-xs);
    color: var(--muted-text);
    font-variant-numeric: tabular-nums;
  }

  .rel-tag {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.18rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary-600);
    color: #fff;
  }

  .rel-content h3 {
    font-size: var(--text-2xl);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
    text-wrap: balance;
  }

  .rel-standfirst {
    max-width: 64ch;
    color: var(--muted-text);
    margin: 0 0 1.5rem;
  }

  .rel-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rel-list li {
    max-width: 66ch;
    padding-left: 1.15rem;
    position: relative;
    color: var(--muted-text);
  }

  .rel-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-accent-500);
  }

  .rel-list strong {
    color: var(--text);
    font-weight: 600;
  }

  .rel-beta {
    max-width: 66ch;
    margin: 1.75rem 0 0;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--muted-text);
    font-size: var(--text-sm);
  }

  .rel-beta-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-500);
    margin-right: 0.6rem;
  }

  .rel-foot {
    padding: 2.5rem 0 5rem;
    border-top: 1px solid var(--border);
    margin-top: 3rem;
  }

  .rel-foot p {
    color: var(--muted-text);
    font-size: var(--text-sm);
    max-width: 60ch;
    margin: 0;
  }

  @media (max-width: 720px) {
    .rel {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .rel-meta {
      position: static;
      flex-direction: row;
      align-items: baseline;
      gap: 0.75rem;
    }

    .rel-tag {
      margin-top: 0;
    }
  }
</style>
